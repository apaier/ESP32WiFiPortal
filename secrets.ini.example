; Copy to secrets.ini (git-ignored) and fill in. Values here override
; the [secrets] defaults in platformio.ini.
;
; ota_password is compiled into the firmware and sent by espota when
; uploading over WiFi. Stick to letters, digits, - and _ so it survives
; the build-flag and command-line quoting.
[secrets]
ota_password = change-me
ota_host = esp32-portal.local
